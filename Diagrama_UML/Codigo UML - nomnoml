

[<abstract> Objetogame |
	x : Number
	y : Number
	largura : Number
	altura : Number
	sprite : Sprite
	|
	constructor() : void
	desenhar() : void
	pegarImagem() : Sprite
	atualizar() : void
]

[Player |
	yInicial : Number
	velocidadeY : Number
	gravidade : Number
	estaPulando : Boolean
	sprite : Animador
	|
	constructor() : void
	atualizar() : void
	pular() : void
]

[Obstaculo |
	velocidade : Number
	sprite : Sprite
	|
	constructor() : void
	atualizar() : void
]

[SpriteAnimado |
	totalQuadros : Number
	duracaoQuadro : Number
	quadroAtual : Number
	acumulado : Number
	|
	constructor() : SpriteAnimado
	reiniciar() : void
	atualizar() : void
	desenhar() : void
]

[Jogo |
	canvas : Canvas
	ctx : Canvas
	scoreElement : Element
	startScreen : Element
	gameOverScreen : Element
	//Element são apenas elementos dentro do HTML
	dino : Player
	obstaculos : List<Obstaculo>
	emExecucao : Boolean
	gameOver : Boolean
	evento10SegundosAtivado : Boolean
	tempo : Number
	tempoObs : Number
	score : Number
	ultimotempo : Number
	|
	constructor() : Jogo
	resetar() : void
	iniciar() : void
	escutarTeclas() : void
	gerarObstaculo() : void
	checarColisao() : Boolean
	finalizarJogo() : void
	loop() : void
]

[Animador |
	animacoes : List<SpriteAnimado>
	atual : SpriteAnimado
	|
	constructor() : Animador
	trocar() : void
	atualizar() : void
	desenhar() : void
]

[Sprite |
	imagem : Image
	|
	constructor() : Sprite
	carregado() : Boolean
	atualizar() : void
	reiniciar() : void
	desenhar() : void
]

//herança
[Player] -:> [Objetogame]
[Obstaculo] -:> [Objetogame]
[SpriteAnimado] -:> [Sprite]

//composição e agregação
[Player] +- [Animador]
[Sprite] -+ [Obstaculo]
[Animador] +- [SpriteAnimado]
[Player] -+ [Jogo]
[Jogo] o- [Obstaculo] 
